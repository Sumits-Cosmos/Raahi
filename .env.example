# Environment Configuration Template for Raahi
# Copy this file to .env (which is git-ignored) and fill in your keys

PORT=4000
NODE_ENV=development
DB_CONNECT=mongodb://localhost:27017/raahi
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_key_here

# Third-Party Geocoding & Maps APIs
LOCATIONIQ_API=your_locationiq_api_key
AUTOCOMPLETESUGGETION_API=your_geoapify_api_key
GOOGLE_MAPS_API=your_google_maps_api_key

# Docker Hub Deployment
DOCKERHUB_USERNAME=your_dockerhub_username
